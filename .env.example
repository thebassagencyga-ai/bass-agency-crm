# Copy to .env.local for local development. Placeholder values only — never commit real keys.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
# Server only. Never prefix with NEXT_PUBLIC_. Never expose to the browser.
SUPABASE_SECRET_KEY=replace-with-local-secret-key
APP_TIME_ZONE=America/New_York
