# Copy to .env.local (next dev) or .dev.vars (wrangler / cf:preview). Never commit real values.
# None of these are NEXT_PUBLIC_: the browser never talks to Supabase directly.

# CRM Supabase project (Dashboard → Project Settings → API). Local stack: `npx supabase status`.
SUPABASE_URL=http://127.0.0.1:54321
# Publishable ("anon") key. Not secret: row level security protects the data.
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key

# Public URL of this app, used in password-reset links.
SITE_URL=http://127.0.0.1:3000

# Local testing over plain http only: allow session cookies without the Secure flag.
# Never set this in production.
# INSECURE_COOKIES_FOR_LOCAL_TESTS=1

# AI helpers (Phase 19, ADR-035). Leave unset: the helpers stay off and hidden. In production the
# key is an encrypted Worker secret set in the Cloudflare dashboard (runbook §4d), never here.
# ANTHROPIC_API_KEY=
# Optional: a lower monthly cap in US dollars (never above 10).
# AI_MONTHLY_BUDGET_USD=10

# New-lead alerts (Phase 26, ADR-044). Leave unset: alerts stay off. In production the key is an
# encrypted Worker secret (runbook §4e), made in Settings → Alerts; for local tests run
# `node scripts/make-test-push-key.mjs`. Never commit a real key.
# PUSH_KEY=
