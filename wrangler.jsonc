{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bass-agency-crm",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    // Serve /offline.html at that exact path (no redirect to /offline): the service worker
    // pre-caches it by name and shows it when a page cannot load offline (ADR-025).
    "html_handling": "none"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "bass-agency-crm"
    }
  ],
  "observability": {
    "enabled": true
  }
  // Secrets (Supabase keys) are set with `wrangler secret put`, never in this file.
}
